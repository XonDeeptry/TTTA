// Schema nguồn sự thật (mục 3.4 kiến trúc). core-api là service DUY NHẤT chạm Postgres —
// gateway/worker luôn đi qua REST API của core-api, không bao giờ connect thẳng DB này.
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BindingStatus {
  pending
  active
}

enum SubmissionStatus {
  received
  processing
  graded
  awaiting_review
  sent
  failed
}

enum SubmissionKind {
  audio
  video
  text
  image
  file
  follow
}

enum DashboardRole {
  admin
  staff
}

model Course {
  id         Int        @id @default(autoincrement())
  key        String     @unique
  bandDesc   String?    @map("band_desc")
  llmConfig  Json       @map("llm_config")
  isActive   Boolean    @default(true) @map("is_active")
  criteria   Criteria[]
  students   Student[]

  @@map("courses")
}

model Criteria {
  id             Int        @id @default(autoincrement())
  courseId       Int        @map("course_id")
  course         Course     @relation(fields: [courseId], references: [id])
  title          String
  rubric         Json
  sourceFilename String?    @map("source_filename")
  version        Int        @default(1)
  // F10: chỉ TRUY VẾT "soạn ra từ mẫu nào" — lưu id thô, KHÔNG có quan hệ, đúng tiền lệ
  // `PilotTextGrading.criteriaId` trong chính schema này. Cố ý không @relation, không
  // REFERENCES, không ON DELETE, không index: nhờ vậy xóa một `rubric_templates` không bao
  // giờ đụng tới `criteria` đã soạn (BR-07/BR-08) và một giá trị mồ côi là trạng thái BÌNH
  // THƯỜNG, không phải lỗi dữ liệu. F12 mới là bên GHI trường này; F10 luôn để NULL.
  templateKey    String?    @map("template_key")
  createdAt      DateTime   @default(now()) @map("created_at")
  gradings       Grading[]

  @@map("criteria")
}

// status là chuỗi mở (Foundation chỉ nêu 'active'/'paused'…, không chốt tập đóng)
model Student {
  id               Int            @id @default(autoincrement())
  code             String         @unique
  fullName         String         @map("full_name")
  phone            String
  courseId         Int?           @map("course_id")
  course           Course?        @relation(fields: [courseId], references: [id])
  className        String?        @map("class_name")
  campus           String?
  status           String         @default("active")
  syncedFromSheetAt DateTime?     @map("synced_from_sheet_at")
  // F9: ánh xạ Zalo-user → học viên → cấp độ (mục 5). Ảnh chụp cấp độ của bài NỘP gần nhất
  // (theo submissions.received_at, KHÔNG phải thời điểm ghi) — có thể đi xuống, và một lần
  // chấm lại bài cũ không được ghi đè cấp độ mới hơn (BR-09).
  currentLevelCode String?        @map("current_level_code")
  currentLevelAt   DateTime?      @map("current_level_at")
  bindings         ZaloBinding[]
  submissions      Submission[]

  @@index([phone])
  @@map("students")
}

// status='pending' ⇔ tab ChoGan cũ; nhiều dòng cùng zaloUserId = một Zalo nhiều học viên (mục 3.6)
model ZaloBinding {
  id           Int           @id @default(autoincrement())
  zaloUserId   String        @map("zalo_user_id")
  studentId    Int?          @map("student_id")
  student      Student?      @relation(fields: [studentId], references: [id])
  displayName  String?       @map("display_name")
  status       BindingStatus @default(pending)
  phoneEntered String?       @map("phone_entered")
  createdAt    DateTime      @default(now()) @map("created_at")

  @@index([zaloUserId])
  @@map("zalo_bindings")
}

model AssignmentCalendar {
  date DateTime @id @db.Date
  note String?

  @@map("assignment_calendar")
}

model Submission {
  id             Int        @id @default(autoincrement())
  messageId      String     @unique @map("message_id")
  zaloUserId     String     @map("zalo_user_id")
  studentId      Int?       @map("student_id")
  student        Student?   @relation(fields: [studentId], references: [id])
  kind           SubmissionKind
  mediaUrlZalo   String?    @map("media_url_zalo")
  mediaPath      String?    @map("media_path")
  mediaDeletedAt DateTime?  @map("media_deleted_at")
  audioExtractedAt DateTime? @map("audio_extracted_at")
  videoDeletedAt DateTime?  @map("video_deleted_at")
  durationSec    Int?       @map("duration_sec")
  status         SubmissionStatus @default(received)
  receivedAt     DateTime   @default(now()) @map("received_at")
  grading        Grading?
  flags          Flag[]
  costLogs       CostLog[]
  pilotTextGrading PilotTextGrading?

  @@map("submissions")
}

model Grading {
  id               Int        @id @default(autoincrement())
  submissionId     Int        @unique @map("submission_id")
  submission       Submission @relation(fields: [submissionId], references: [id])
  criteriaId       Int        @map("criteria_id")
  criteria         Criteria   @relation(fields: [criteriaId], references: [id])
  criteriaVersion  Int        @map("criteria_version")
  scores           Json
  llmFeedback      String     @map("llm_feedback")
  reviewedFeedback String?    @map("reviewed_feedback")
  reviewedBy       String?    @map("reviewed_by")
  autoSent         Boolean    @default(false) @map("auto_sent")
  sentAt           DateTime?  @map("sent_at")
  // F9: kết quả `computeTotal` chốt tại thời điểm chấm — phục vụ HIỂN THỊ, tin nhắn Zalo (F11)
  // và ánh xạ cấp độ học viên. Báo cáo KHÔNG đọc mấy cột này mà tính lại từ `scores` (BR-06).
  // NULL = chưa tính: grading trước F9, hoặc `counted === 0` (BR-05). Không có backfill (BR-07).
  totalScore       Float?     @map("total_score")
  levelCode        String?    @map("level_code")
  levelLabel       String?    @map("level_label")
  // Cột do F11 ghi (nút "#ilm:ack:<id>"); F9 chỉ TẠO cột, không bao giờ ghi (BR-11).
  studentAckAt     DateTime?  @map("student_ack_at")

  @@map("gradings")
}

// Pilot A/B: chấm điểm bằng nhánh text (transcript-only) song song với Grading (nhánh audio),
// để so sánh chất lượng/chi phí. Một submission có tối đa một bản ghi pilot (1-1, giống Grading).
// criteriaId chỉ lưu id thô (không có quan hệ tới Criteria) — đủ cho mục đích đối chiếu pilot.
model PilotTextGrading {
  id              Int        @id @default(autoincrement())
  submissionId    Int        @unique @map("submission_id")
  submission      Submission @relation(fields: [submissionId], references: [id])
  criteriaId      Int        @map("criteria_id")
  criteriaVersion Int        @map("criteria_version")
  transcript      String
  scores          Json
  llmFeedback     String     @map("llm_feedback")
  provider        String
  model           String
  createdAt       DateTime   @default(now()) @map("created_at")

  @@map("pilot_text_grading")
}

model Flag {
  id              Int        @id @default(autoincrement())
  submissionId    Int        @map("submission_id")
  submission      Submission @relation(fields: [submissionId], references: [id])
  reason          String
  assignedAdvisor String?    @map("assigned_advisor")
  resolvedAt      DateTime?  @map("resolved_at")

  @@map("flags")
}

model ClassConfig {
  className      String  @id @map("class_name")
  advisorZaloId  String  @map("advisor_zalo_id")
  autoSend       Boolean @default(false) @map("auto_send")

  @@map("classes_config")
}

// Cấu hình ứng dụng quản trị qua UI (v1.2): zalo.*, llm.*, limits.*, sheets.*, internal.* —
// mirror sang Redis config:{key} + publish config:changed khi ghi (xem SettingsService).
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  @@map("settings")
}

model MessageTemplate {
  key  String
  lang String
  body String

  @@id([key, lang])
  @@map("message_templates")
}

model OutboundLog {
  id         Int      @id @default(autoincrement())
  zaloUserId String   @map("zalo_user_id")
  payload    Json
  status     String
  error      String?
  sentAt     DateTime @default(now()) @map("sent_at")

  @@map("outbound_log")
}

model CostLog {
  id           Int         @id @default(autoincrement())
  submissionId Int?        @map("submission_id")
  submission   Submission? @relation(fields: [submissionId], references: [id])
  provider     String
  model        String
  inputTokens  Int      @map("input_tokens")
  outputTokens Int      @map("output_tokens")
  estUsd       Decimal  @map("est_usd") @db.Decimal(10, 4)
  callType     String?  @map("call_type")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("cost_log")
}

model SheetSyncLog {
  id          Int      @id @default(autoincrement())
  runAt       DateTime @default(now()) @map("run_at")
  rowsOk      Int      @map("rows_ok")
  rowsError   Int      @map("rows_error")
  errorDetail Json?    @map("error_detail")

  @@map("sheet_sync_log")
}

// Không có trong tài liệu kiến trúc gốc — bổ sung cho quyết định "session auth thật ngay từ M2"
// (thay vì API key tạm chờ M4). 2 vai trò tối giản theo mục 3.7: admin (IT) / staff (tư vấn/GV).
model DashboardUser {
  id                 Int           @id @default(autoincrement())
  email              String        @unique
  passwordHash       String        @map("password_hash")
  role               DashboardRole
  mustChangePassword Boolean       @default(false) @map("must_change_password")
  // F10 (thiết kế mục 4.2): quyền phụ, ĐỘC LẬP với role — vẫn đúng 2 role cũ, không thêm
  // role thứ ba. Giá trị hợp lệ: 'rubric_template' | 'criteria_author' (auth/privileges.ts).
  // `admin` mặc nhiên có mọi quyền nên mảng này bị BỎ QUA khi role = admin.
  privileges         String[]      @default([])
  createdAt          DateTime      @default(now()) @map("created_at")

  @@map("dashboard_users")
}

// F10 — mẫu CẤU TRÚC chấm điểm (thiết kế Phần 4). Hai mẫu mặc định được seed vào đây lúc
// khởi động khi bảng còn RỖNG (BootstrapRubricTemplatesService), nên chúng là DỮ LIỆU sửa
// được bằng UI chứ không phải hằng số trong code.
//
// KHÔNG có khóa ngoại nào trỏ vào bảng này (xem `Criteria.templateKey`) — đó chính là điều
// khiến "xóa mẫu" là một thao tác an toàn, không hồi tố lên `criteria`/`gradings`.
model RubricTemplate {
  id        Int      @id @default(autoincrement())
  // định danh ổn định, BẤT BIẾN sau khi tạo (reset + truy vết đều tra theo key)
  key       String   @unique
  name      String
  // một RubricV2 đã `normalizeRubric` (12 khóa top-level)
  rubric    Json
  // đường dẫn trường mà NGƯỜI SOẠN NỘI DUNG không được sửa; không ràng buộc `rubric_template`
  locked    String[] @default([])
  // chỉ seeder mới đặt true — chặn xóa (409) và bật nút "khôi phục bản gốc"
  isSystem  Boolean  @default(false) @map("is_system")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("rubric_templates")
}
