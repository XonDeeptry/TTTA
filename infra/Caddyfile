# DOMAIN lấy từ biến môi trường (docker-compose). Dùng "localhost" khi dev local.
{$DOMAIN:localhost} {
	handle /webhook* {
		reverse_proxy zalo-gateway:3000
	}

	handle /healthz {
		reverse_proxy zalo-gateway:3000
	}

	handle /api* {
		uri strip_prefix /api
		reverse_proxy core-api:3001
	}

	# Dashboard SPA (M4) — build container sao chép dist/ vào volume dashboarddist,
	# Caddy chỉ serve tĩnh, không cần Node/nginx chạy runtime.
	handle {
		root * /srv/dashboard
		# index.html không có Cache-Control thì trình duyệt tự giữ bản cũ, và bản cũ trỏ vào bundle
		# cũ vẫn còn trong volume — sau mỗi lần deploy người dùng thấy giao diện cũ (pilot 09-15).
		# File trong /assets/ có hash trong tên nên giữ lâu được; mọi thứ khác phải hỏi lại.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@unhashed not path /assets/*
		header @unhashed Cache-Control "no-cache"
		file_server
		try_files {path} /index.html
	}
}
